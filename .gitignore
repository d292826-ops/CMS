# macOS
.DS_Store
._*

# Node.js / React / Vite
/.tools/
node_modules/
dist/
build/
coverage/
.vite/
*.tsbuildinfo

# Python / Django
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
staticfiles/

# Local environment and secrets; only empty examples may be committed
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
/secrets/

# Local databases and backups
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.dump
*.sql.gz
backups/

# Logs
*.log
logs/

# Runtime volumes for self-hosted deployment
/app/deploy/data/
/app/deploy/config/
/caddy_data/
/caddy_config/

# Temporary browser diagnostics / generated print samples
/app/tests/results/browser-failure.json
/app/tests/results/*.pdf
